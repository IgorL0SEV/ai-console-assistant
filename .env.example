# Эта ветка — пресет для прямого Anthropic API
LLM_PROVIDER=anthropic

# Нужен ключ Anthropic (platform.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-ВАШ_КЛЮЧ

# Ключи других провайдеров не нужны
PROXYAPI_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Модели. Пусто = пресет ветки.
NORMAL_MODEL=
THINKING_MODEL=

# Режим по умолчанию: normal | thinking
DEFAULT_MODE=thinking

# Бюджет размышлений Claude (минимум 1024, меньше MAX_TOKENS)
REASONING_BUDGET=1500

# Предел длины ответа
MAX_TOKENS=4096
NORMAL_MAX_TOKENS=2048

# Уровень reasoning для OpenAI/OpenRouter: minimal | low | medium | high
NORMAL_REASONING_EFFORT=medium

# Системный промпт
SYSTEM_PROMPT=Вы полезный ассистент. Отвечайте на русском языке.

# Сеть
REQUEST_TIMEOUT=90
MAX_RETRIES=1

# История диалога
MAX_HISTORY_MESSAGES=40
HISTORY_FILE=data/history.json
LOG_FILE=data/assistant.log

# Адреса API
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=https://api.anthropic.com
