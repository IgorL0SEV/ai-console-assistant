# Провайдер: proxyapi | anthropic | openai | openrouter
LLM_PROVIDER=proxyapi

# Ключи. Нужен только ключ выбранного провайдера.
PROXYAPI_KEY=sk-ВАШ_КЛЮЧ_PROXYAPI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Модели. Пусто = значения по умолчанию для провайдера.
NORMAL_MODEL=openai/gpt-5-mini
THINKING_MODEL=anthropic/claude-sonnet-4-5

# Режим по умолчанию: normal | thinking
DEFAULT_MODE=thinking

# Бюджет размышлений Claude (минимум 1024, меньше MAX_TOKENS)
REASONING_BUDGET=1500

# Предел длины ответа
MAX_TOKENS=4096
NORMAL_MAX_TOKENS=2048

# Уровень reasoning для OpenAI/OpenRouter: minimal | low | medium | high
NORMAL_REASONING_EFFORT=medium

# Системный промпт
SYSTEM_PROMPT=Вы полезный ассистент. Отвечайте на русском языке.

# Сеть
REQUEST_TIMEOUT=90
MAX_RETRIES=1

# История диалога
MAX_HISTORY_MESSAGES=40
HISTORY_FILE=data/history.json
LOG_FILE=data/assistant.log

# Адреса API. Пусто = значения по умолчанию для провайдера.
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
